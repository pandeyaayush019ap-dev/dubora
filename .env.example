# ==========================================
# DUBORA — AI Multilingual Video Dubbing SaaS
# Environment Configuration Template
# ==========================================

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth & PostgreSQL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Dubbing Providers
# 1. ElevenLabs Dubbing API (Default integrated provider)
ELEVENLABS_API_KEY=""

# 2. Modular Speech Recognition (STT) - Optional if using modular pipeline
OPENAI_API_KEY=""

# 3. Translation Model - Optional if using modular pipeline
ANTHROPIC_API_KEY=""

# Object Storage (S3 / Cloudflare R2 / MinIO compatible)
# In development, local file storage engine is automatically used if credentials are empty
STORAGE_PROVIDER="local" # "local" | "s3" | "r2"
STORAGE_ENDPOINT=""
STORAGE_BUCKET="dubora-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="auto"

# Background Job Queue (Redis)
# When REDIS_URL is not set, Dubora uses an embedded reliable in-memory/disk queue
REDIS_URL="redis://localhost:6379"

# Stripe Billing (Optional for Launch)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
